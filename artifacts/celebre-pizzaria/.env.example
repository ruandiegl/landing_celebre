# Ambiente da API. Nunca use estes valores diretamente em produção.
NODE_ENV=development

# Credencial do administrador. Gere ADMIN_PASSWORD_HASH com:
# pnpm exec tsx scripts/hash-admin-password.ts
ADMIN_USERNAME=administrator
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Vercel Blob (não prefixar com VITE_ porque é segredo server-side).
BLOB_READ_WRITE_TOKEN=
CONTENT_BLOB_PATH=images-celebre/config/landing-content.json

# Origens permitidas para mutações administrativas, separadas por vírgula.
ADMIN_ALLOWED_ORIGINS=http://localhost:5173
